# Copy to .env.local for local `python main.py dev`. On LiveKit Cloud these are set as secrets.

# LiveKit Cloud project (the 3rd project, dedicated to Ooink)
LIVEKIT_URL=wss://your-ooink-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini via Google AI Studio (NOT Vertex). https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Deepgram STT (nova-3)
DEEPGRAM_API_KEY=

# Cartesia TTS. Pick a warm voice id from the Cartesia dashboard; the default below is
# the voice used in LiveKit's own docs. Swap models/voices freely (cost driver — see AGENTS.md).
CARTESIA_API_KEY=
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Firebase embedding function. Override only if the project id changes.
EMBEDDING_FUNCTION_URL=https://us-central1-ooinkai.cloudfunctions.net/generateEmbedding

# Dispatch name registered by the agent and requested by the token function.
LIVEKIT_AGENT_NAME=ooink-pig

LIVEKIT_LOG_LEVEL=info
